<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up | Members Only</title>
</head>
<body>
    <main>
        <h1>Sign Up</h1>

        <% if (locals.errors) { %>
            <ul>
                <% errors.forEach((error) => { %>
                    <li><%= error.msg %></li>
                <% }) %>
            </ul>
        <% } %>

        <form action="/sign-up" method="POST">
            <div>
                <label for="firstName">First Name</label>
                <input
                    type="text"
                    id="firstName"
                    name="firstName"
                    value="<%= locals.formData?.firstName || '' %>"
                    required
                >
            </div>

            <div>
                <label for="lastName">Last Name</label>
                <input
                    type="text"
                    id="lastName"
                    name="lastName"
                    value="<%= locals.formData?.lastName || '' %>"
                    required
                >
            </div>

            <div>
                <label for="username">Username</label>
                <input
                    type="text"
                    id="username"
                    name="username"
                    value="<%= locals.formData?.username || '' %>"
                    required
                >
            </div>

            <div>
                <label for="password">Password</label>
                <input
                    type="password"
                    id="password"
                    name="password"
                    required
                >
            </div>

            <div>
                <label for="confirmPassword">Confirm Password</label>
                <input
                    type="password"
                    id="confirmPassword"
                    name="confirmPassword"
                    required
                >
            </div>

            <button type="submit">Sign Up</button>
        </form>

        <p>
            Already have an account?
            <a href="/log-in">Log in</a>
        </p>
    </main>
</body>
</html>