<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Join the Club | Members Only</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="form-page">
    <main class="form-card">
        <h1>Join the Club</h1>

        <p class="form-description">
            Enter the secret passcode to become a club member.
        </p>

        <% if (locals.error) { %>
            <p class="error-message"><%= error %></p>
        <% } %>

        <form action="/join-club" method="POST">
            <div>
                <label for="passcode">Secret Passcode</label>
                <input
                    type="password"
                    id="passcode"
                    name="passcode"
                    required
                >
            </div>

            <button type="submit">Join Club</button>
        </form>

        <p class="form-footer">
            <a href="/">Back to Home</a>
        </p>
    </main>
</body>
</html>