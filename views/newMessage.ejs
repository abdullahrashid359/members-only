<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Message | Members Only</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="form-page">
    <main class="form-card">
        <h1>Create Message</h1>

        <% if (locals.errors) { %>
            <ul class="error-list">
                <% errors.forEach((error) => { %>
                    <li><%= error.msg %></li>
                <% }) %>
            </ul>
        <% } %>

        <form action="/messages/new" method="POST">
            <div>
                <label for="title">Title</label>
                <input
                    type="text"
                    id="title"
                    name="title"
                    value="<%= locals.formData?.title || '' %>"
                    required
                >
            </div>

            <div>
                <label for="text">Message</label>
                <textarea
                    id="text"
                    name="text"
                    required
                ><%= locals.formData?.text || '' %></textarea>
            </div>

            <button type="submit">Create Message</button>
        </form>

        <p class="form-footer">
            <a href="/">Cancel</a>
        </p>
    </main>
</body>
</html>