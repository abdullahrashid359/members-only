<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Become Admin | Members Only</title>
</head>
<body>
    <main>
        <h1>Become an Admin</h1>

        <p>Enter the admin passcode to gain administrator privileges.</p>

        <% if (locals.error) { %>
            <p><%= error %></p>
        <% } %>

        <form action="/become-admin" method="POST">
            <div>
                <label for="passcode">Admin Passcode</label>
                <input
                    type="password"
                    id="passcode"
                    name="passcode"
                    required
                >
            </div>

            <button type="submit">Become Admin</button>
        </form>

        <a href="/">Back to Home</a>
    </main>
</body>
</html>