<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Members Only</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header class="site-header">
        <div class="header-content">
            <a href="/" class="brand">Members Only</a>

            <div class="header-right">
                <% if (currentUser) { %>
                    <span class="welcome-text">
                        Welcome, <%= currentUser.first_name %>!
                    </span>

                    <nav class="nav-actions">
                        <a href="/messages/new">New Message</a>

                        <% if (!currentUser.membership_status) { %>
                            <a href="/join-club">Join Club</a>
                        <% } %>

                        <% if (!currentUser.admin_status) { %>
                            <a href="/become-admin">Become Admin</a>
                        <% } %>

                        <form action="/log-out" method="POST">
                            <button type="submit">Log Out</button>
                        </form>
                    </nav>
                <% } else { %>
                    <nav class="nav-actions">
                        <a href="/log-in">Log In</a>
                        <a href="/sign-up">Sign Up</a>
                    </nav>
                <% } %>
            </div>
        </div>
    </header>

    <main class="messages-container">
        <h2>Messages</h2>

        <% if (messages.length === 0) { %>
            <p>No messages yet.</p>
        <% } %>

        <% messages.forEach((message) => { %>
            <article class="message-card">
                <h3><%= message.title %></h3>

                <p><%= message.text %></p>

                <% if (currentUser?.membership_status) { %>
                    <div class="message-meta">
                        <p>
                            Posted by <%= message.first_name %> <%= message.last_name %>
                            (<%= message.username %>)
                        </p>

                        <p>
                           <%= message.timestamp.toLocaleString("en-US", {
                                month: "short",
                                day: "numeric",
                                year: "numeric",
                                hour: "numeric",
                                minute: "2-digit",
                                hour12: true
                            }) %>
                        </p>
                    </div>
                <% } %>

                <% if (currentUser?.admin_status) { %>
                    <form
                        class="delete-form"
                        action="/messages/<%= message.id %>/delete"
                        method="POST"
                    >
                        <button class="danger-button" type="submit">
                            Delete
                        </button>
                    </form>
                <% } %>
            </article>
        <% }) %>
    </main>
</body>
</html>